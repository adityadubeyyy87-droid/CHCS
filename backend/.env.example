# ─────────────────────────────────────────────────────────────────────────────
# CHSC backend environment · copy to .env and edit DB_PASSWORD
# ─────────────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# Comma-separated browser origins allowed by CORS / Socket.io
# Includes the backend origin itself: when the production build is served by the
# backend (http://localhost:4000) the browser sends that origin, so it must be allowed.
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4000,http://127.0.0.1:4000

# MySQL 8.4
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=community_health_scheduler
DB_POOL_SIZE=20

# JWT — REQUIRED. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES=12h

# Production identity bootstrap (only used by `npm run start:production`).
# Create four operational accounts; no patients, camps or bookings are seeded.
# Passwords must be at least 12 characters. Keep these values in the host's
# secret store, never in Git.
BOOTSTRAP_PHONE_SEED=9000000000
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ORGANIZER_EMAIL=
BOOTSTRAP_ORGANIZER_NAME=
BOOTSTRAP_ORGANIZER_PASSWORD=
BOOTSTRAP_DOCTOR_EMAIL=
BOOTSTRAP_DOCTOR_NAME=
BOOTSTRAP_DOCTOR_PASSWORD=
BOOTSTRAP_VOLUNTEER_EMAIL=
BOOTSTRAP_VOLUNTEER_NAME=
BOOTSTRAP_VOLUNTEER_PASSWORD=
# One-time only, when replacing a seeded/demo DB with real data. Production
# requires BOTH flags; return both to false after the reset:
PURGE_ON_BOOT=false
ALLOW_PRODUCTION_PURGE=false

# Reverse proxy trust is OFF by default. Enable only behind a known proxy:
#   TRUST_PROXY=loopback | 1 | 10.0.0.1,10.0.0.2 | true
TRUST_PROXY=false

# The API is live-only. Demo endpoints and the local fallback do not exist.
# HOST=127.0.0.1

# Slot regeneration never deletes bookings. To permit an explicit destructive
# rebuild you must set BOTH this flag and send { force:true, destructive:true }
# from an ADMIN account. Keep false in normal operation.
ALLOW_DESTRUCTIVE_SLOT_REBUILD=false

# Capacity Advisor maximum overbooking safety cap (α_max)
ALPHA_MAX=0.25

# Bounded reservation windows. A booking is HELD for 10 minutes until the
# patient confirms; a promoted FIFO waiter has 15 minutes to claim the seat.
# The expiry sweep runs every minute and can be disabled with HOLD_EXPIRY_CRON=off.
BOOKING_HOLD_MINUTES=10
PROMOTION_HOLD_MINUTES=15
HOLD_EXPIRY_BATCH_SIZE=100
HOLD_EXPIRY_CRON=* * * * *

# Optional real email gateway. Leave blank to use the live sandbox interceptor.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=CMRIT Community Health <no-reply@cmrit.edu>

# Optional real SMS gateway. Leave blank for Fast2SMS/Twilio sandbox simulation.
SMS_PROVIDER=Fast2SMS Sandbox
FAST2SMS_API_KEY=
