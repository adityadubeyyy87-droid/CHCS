{
  "name": "chsc-backend",
  "version": "1.0.0",
  "private": true,
  "description": "CHSC — Community Health Screening Camp Scheduler API (Express + MySQL + Socket.io)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "start:production": "node scripts/db.js setup-production && node scripts/bootstrap-production.js && node server.js",
    "dev": "node --watch server.js",
    "seed": "node seed.js",
    "db:bootstrap": "node scripts/bootstrap-production.js",
    "verify:live": "node scripts/verify-live.js",
    "db:setup": "node scripts/db.js setup",
    "db:migrate": "node scripts/db.js migrate",
    "db:start": "node scripts/db.js start",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.5",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.16",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "supertest": "^7.0.0",
    "vitest": "^2.1.8"
  }
}
